% Figure counter for auto-numbering
\newcounter{misqfigure}
\renewcommand{\themisqfigure}{\arabic{misqfigure}}

% Custom figure environment as 1x2 table
% Usage: \begin{misqfigure}{Figure Caption} ... figure content ... \end{misqfigure}
% The figure content goes in the top row, caption with numbering in bottom row
\makeatletter
\newenvironment{misqfigure}[1]{%
    \stepcounter{misqfigure}%
    \begin{table}[htbp]%
    \def\@currentlabel{\themisqfigure}%
    \figurefont%
    \fontsize{10}{12}\selectfont%
    \centering%
    % Store the figure caption with numbering
    \def\misqfigcaption{Figure \themisqfigure: #1}%
    % Create a 1-column table with borders to match table style
    \begin{tabular}{|p{0.95\textwidth}|}%
    \hline%
    % Top row: figure content (centered)
    % Use a safe width for minipage that accounts for borders
    \begin{minipage}{0.95\textwidth}%
    \centering%
}{%
    \end{minipage} \\%
    \hline%
    % Bottom row: caption with black background and white text (left-aligned, wraps if needed)
    \cellcolor{black}\textcolor{white}{\bfseries \misqfigcaption} \\%
    \hline%
    \end{tabular}%
    \end{table}%
}
\makeatother

% Section formatting
% Sections: centered, numbered, bold, Times New Roman 12pt, all caps
% Subsections: left-aligned, numbered, sentence case, bold
\makeatletter
% Ensure sections are numbered
\setcounter{secnumdepth}{3}

\renewcommand\section{\@startsection {section}{1}{\z@}%
                                   {1\baselineskip}%
                                   {1.2ex \@plus .2ex}%
                                   {\centering\normalfont\fontsize{12}{14}\selectfont\bfseries\bodyfont\MakeUppercase}}

\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
                                     {-3.25ex\@plus -1ex \@minus -.2ex}%
                                     {0.6ex \@plus .2ex}%
                                     {\normalfont\normalsize\bfseries\bodyfont\raggedright}}

% Appendix counter and formatting
\newcounter{misqappendix}
\renewcommand{\themisqappendix}{\Alph{misqappendix}}

% Appendix section command
% Usage: \misqappendix{Appendix Title}
\newcommand{\misqappendix}[1]{%
    \stepcounter{misqappendix}%
    \vspace{2.3ex \@plus .2ex}%
    \noindent%
    {\centering\normalfont\fontsize{12}{14}\selectfont\bfseries\bodyfont%
     APPENDIX \themisqappendix: \MakeUppercase{#1}\par}%
    \vspace{1.5ex}%
}

\makeatother

% Paragraph formatting
\setlength{\parindent}{0.5in}
\setlength{\parskip}{0pt}

% Adjust float placement parameters to allow tables on pages with text
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.9}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.7}

% Reduce spacing around floats (tables and figures) to match double spacing
\setlength{\floatsep}{0.5\baselineskip}
\setlength{\textfloatsep}{0.5\baselineskip}
\setlength{\intextsep}{0.5\baselineskip}

% Line spacing for body text (double-spaced)
\doublespacing

% Fully justified text (both left and right aligned)
\justifying
% Disable hyphenation - prevent words from breaking
\hyphenpenalty=10000
\exhyphenpenalty=10000
% Allow flexible spacing between words to fill lines
\sloppy
\tolerance=10000
\emergencystretch=3em
\hbadness=10000

\endinput
